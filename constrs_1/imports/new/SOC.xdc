create_clock -name sys_clk -period 20.000 [get_ports clk]
set_property PACKAGE_PIN W19 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property PACKAGE_PIN Y19 [get_ports rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n]
set_property PACKAGE_PIN R16 [get_ports download_en_i]
set_property IOSTANDARD LVCMOS33 [get_ports download_en_i]
set_property PACKAGE_PIN W17 [get_ports uart_rx_i]
set_property IOSTANDARD LVCMOS33 [get_ports uart_rx_i]
set_property PACKAGE_PIN V17 [get_ports uart_tx_o]
set_property PACKAGE_PIN N20 [get_ports {gpio_out_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports uart_tx_o]


set_property PACKAGE_PIN M20 [get_ports {gpio_out_o[1]}]
set_property PACKAGE_PIN N22 [get_ports {gpio_out_o[2]}]
set_property PACKAGE_PIN M22 [get_ports {gpio_out_o[3]}]
set_property PACKAGE_PIN H22 [get_ports {gpio_out_o[4]}]
set_property PACKAGE_PIN K17 [get_ports {gpio_out_o[5]}]
set_property PACKAGE_PIN K13 [get_ports {gpio_out_o[6]}]
set_property PACKAGE_PIN J20 [get_ports {gpio_out_o[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_out_o[1]}]

